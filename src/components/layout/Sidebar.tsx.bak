"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { Home, Users, UserPlus, MessageSquare, CreditCard, FileText, Settings, BarChart2 } from "lucide-react";
import { useState } from "react";

const navigation = [
  { name: "Tableau de bord", href: "/dashboard", icon: Home },
  { name: "Étudiants", href: "/dashboard/students", icon: Users },
  { name: "Communications", href: "/dashboard/communications", icon: MessageSquare },
  { name: "Paiements", href: "/dashboard/payments", icon: CreditCard },
  { name: "Documents", href: "/dashboard/documents", icon: FileText },
  { name: "Rapports", href: "/dashboard/reports", icon: BarChart2 },
];

export default function Sidebar() {
  const pathname = usePathname();
  const [isHovered, setIsHovered] = useState(false);

  // The sidebar is logically 20 w (80px) space taker, but expands to 64 w (256px) visually by absolute positioning or just expanding in place.
  // Using expanding in place is smoother if we want to push content, but the user said "si j'approche mon curseur, la barre s'ouvre automatiquement... on garde toujours les icones".
  // Let's make it expand in place to not overlap if that's easier, or absolute if we don't want to push layout.
  // Expanding in place (width transitions) is usually safer for dashboard layouts.

  return (
    <div className="w-16 flex-shrink-0 h-full relative z-40" onMouseEnter={() => setIsHovered(true)} onMouseLeave={() => setIsHovered(false)}>
      <div 
        className={`absolute top-0 left-0 h-full flex flex-col border-r border-gray-100 bg-white transition-all duration-300 ease-in-out shadow-[4px_0_24px_rgba(0,0,0,0.05)] overflow-hidden ${isHovered ? "w-64" : "w-16"}`}
      >
      <div className="flex h-16 items-center px-3 border-b border-gray-100 whitespace-nowrap overflow-hidden">
        <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white font-semibold text-xl flex-shrink-0 shadow-sm">
          E
        </div>
        <span className={`text-xl font-bold text-gray-900 tracking-tight ml-3 transition-opacity duration-300 ${isHovered ? "opacity-100" : "opacity-0 w-0"}`}>
          EduCom
        </span>
      </div>

      <div className="flex flex-1 flex-col overflow-y-auto px-3 py-6">
        <div className={`text-xs font-semibold text-text-muted mb-4 px-2 uppercase tracking-wider transition-opacity duration-300 ${isHovered ? "opacity-100" : "opacity-0 hidden"}`}>
          Menu Principal
        </div>
        <nav className="flex-1 space-y-2">
          {navigation.map((item) => {
            const isActive = pathname === item.href || (item.href !== "/dashboard" && pathname?.startsWith(item.href));
            return (
              <Link
                key={item.name}
                href={item.href}
                className={`group flex items-center rounded-xl transition-all duration-200 overflow-hidden ${
                  isHovered ? "px-3 py-3" : "justify-center p-3"
                } ${
                  isActive
                    ? "bg-primary/10 text-primary"
                    : "text-text-secondary hover:bg-secondary hover:text-text-primary"
                }`}
              >
                <item.icon
                  className={`h-4 w-4 flex-shrink-0 transition-colors ${
                    isActive ? "text-primary" : "text-text-muted group-hover:text-text-secondary"
                  }`}
                  aria-hidden="true"
                />
                <span 
                  className={`font-semibold ml-3 whitespace-nowrap transition-all duration-300 ${
                    isHovered ? "opacity-100 translate-x-0" : "opacity-0 -translate-x-4 w-0"
                  }`}
                >
                  {item.name}
                </span>
              </Link>
            );
          })}
        </nav>
        
        <div className="mt-8">
          <div className={`text-xs font-semibold text-text-muted mb-4 px-2 uppercase tracking-wider transition-opacity duration-300 ${isHovered ? "opacity-100" : "opacity-0 hidden"}`}>
            Préférences
          </div>
          <Link
            href="/dashboard/settings"
            className={`group flex items-center rounded-xl transition-all duration-200 overflow-hidden ${
              isHovered ? "px-3 py-3" : "justify-center p-3"
            } ${
              pathname?.startsWith("/dashboard/settings")
                ? "bg-primary/10 text-primary"
                : "text-text-secondary hover:bg-secondary hover:text-text-primary"
            }`}
          >
            <Settings
              className={`h-4 w-4 flex-shrink-0 transition-colors ${
                pathname?.startsWith("/dashboard/settings") ? "text-primary" : "text-text-muted group-hover:text-text-secondary"
              }`}
            />
            <span 
              className={`font-semibold ml-3 whitespace-nowrap transition-all duration-300 ${
                isHovered ? "opacity-100 translate-x-0" : "opacity-0 -translate-x-4 w-0"
              }`}
            >
              Paramètres
            </span>
          </Link>

        </div>
      </div>
    </div>
    </div>
  );
}
